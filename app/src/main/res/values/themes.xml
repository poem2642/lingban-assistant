<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 基础主题：浅色，无默认标题栏（因为我们追求全屏沉浸） -->
    <style name="Theme.LingbanAssistant" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- 引入你刚调的色板 -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="colorOnBackground">@color/on_background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorError">@color/error</item>
        <item name="colorOnError">@color/on_error</item>

        <!-- 全局圆角，让一切柔和 -->
        <item name="shapeAppearanceSmallComponent">@style/Shape.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/Shape.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/Shape.Large</item>

        <!-- 字体 & 状态栏 -->
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/white</item>
        <item name="android:windowLightStatusBar">true</item>  <!-- 状态栏图标变深色 -->
    </style>

    <!-- 小圆角：按钮、文本输入框、芯片 -->
    <style name="Shape.Small" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">10dp</item>
    </style>

    <!-- 中圆角：卡片、对话框 -->
    <style name="Shape.Medium" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">14dp</item>
    </style>

    <!-- 大圆角：底部弹出、底部导航 -->
    <style name="Shape.Large" parent="ShapeAppearance.MaterialComponents.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>
</resources>
